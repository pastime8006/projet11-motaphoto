<?php
// Initialiser l'identifiant à 0 : il restera ainsi si aucune photo ne correspond.
$photo_id = 0;

// Rechercher jusqu'à 20 photos publiées dont le contenu correspond à « Bouquet final ».
// Le paramètre « fields » demande uniquement les identifiants, ce qui évite de charger
// les objets complets des articles pour cette recherche.
$matching_photos = get_posts(
    array(
        'post_type'      => 'photo',
        'post_status'    => 'publish',
        'posts_per_page' => 20,
        's'              => 'Bouquet final',
        'fields'         => 'ids',
    )
);

// Vérifier les titres des résultats pour trouver une correspondance exacte.
// trim() retire les espaces superflus et strcasecmp() ignore les majuscules/minuscules.
foreach ( $matching_photos as $candidate_id ) {
    if ( 0 === strcasecmp( trim( get_the_title( $candidate_id ) ), 'Bouquet final' ) ) {
        // Conserver l'identifiant de la photo trouvée.
        $photo_id = $candidate_id;
        // La photo est trouvée : inutile de parcourir les autres résultats.
        break;
    }
}
?>
<div class="main page-infos">

    <div class="content-zone">
        <div class="content-zone-infos">
            <?php if ( $photo_id ) : ?>
                <?php get_template_part( 'templates_part/infos-photos', null, array( 'photo_id' => $photo_id ) ); ?>
            <?php else : ?>
                <p>La photo « Bouquet final » est introuvable.</p>
            <?php endif; ?>
        </div>

        <div class="content-zone-photos">
            <?php if ( $photo_id && has_post_thumbnail( $photo_id ) ) : ?>
                <?php echo get_the_post_thumbnail( $photo_id, 'large', array( 'class' => 'img-zone-photos' ) ); ?>
            <?php endif; ?>
        </div>
    </div>

    <div class="contact-zone-infos">
        <div class="contact-infos">
            <p>Cette photo vous interese ?</p>
            <button
                class="btn-contact-infos"
                type="button"
                data-reference="<?php echo esc_attr((string) get_field('references', $photo_id)); ?>"
            >
            contact
            </button>
         </div>
        <div class="thumbnails-zone-infos">
           <div class="thumbnails-box">THUMBNAILS</div>
        </div>
    </div>

    <div class="photos-parent">
        <h3>VOUS AIMEREZ AUSSI</h3>
        <div class="img-container">coucou</div>
    </div>

</div>
